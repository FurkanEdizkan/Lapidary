# Lapidary — environment configuration
# Copy to .env (local) or pass via container env.

# HTTP port the Fastify server listens on
PORT=5174

# Where all library data lives (models/, lod/, thumbnails/, images/, profiles/, lapidary.db)
# Local default is ./data ; in the container this is /data (a mounted volume).
DATA_DIR=./data

# Optional Redis cache. If unreachable, the app falls back to an in-process LRU cache.
# REDIS_URL=redis://localhost:6379

# Optional default folder to scan from the Add/Scan flow (e.g. a mounted /library in Docker).
# LIBRARY_PATH=/library

# Optional path to the rust-mesh binary. If absent, LOD/thumbnails are generated client-side.
# MESH_SIDECAR_BIN=rust-mesh
