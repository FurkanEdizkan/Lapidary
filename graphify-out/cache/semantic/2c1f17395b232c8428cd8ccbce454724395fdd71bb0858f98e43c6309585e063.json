ries", "target": "specs_2026_09_02_phase_1_slice_1_ingest_design_hash_first_short_circuit", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-09-06-folder-tree-and-moves-design.md", "source_location": null, "weight": 1.0}, {"source": "specs_2026_09_06_folder_tree_and_moves_design_folder_backfill", "target": "specs_2026_09_06_folder_tree_and_moves_design_folder_table", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-09-06-folder-tree-and-moves-design.md", "source_location": null, "weight": 1.0}, {"source": "specs_2026_09_06_folder_tree_and_moves_design_source_dedup_lost", "target": "specs_2026_09_02_phase_1_slice_1_ingest_design_blob_table", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-09-06-folder-tree-and-moves-design.md", "source_location": null, "weight": 1.0}, {"source": "specs_2026_09_06_folder_tree_and_moves_design_soft_delete_cascade", "target": "specs_2026_09_06_folder_tree_and_moves_design_folder_table", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-09-06-folder-tree-and-moves-design.md", "source_location": null, "weight": 1.0}, {"source": "specs_2026_09_01_phase_0a_foundation_design_lapidary_api", "target": "specs_2026_09_06_folder_tree_and_moves_design_source_relocator", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-09-06-folder-tree-and-moves-design.md", "source_location": null, "weight": 1.0}, {"source": "specs_2026_09_06_folder_tree_and_moves_design_folder_tree", "target": "specs_2026_09_02_phase_1_slice_1_ingest_design_derivative_store", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-09-06-folder-tree-and-moves-design.md", "source_location": null, "weight": 1.0}], "hyperedges": []}