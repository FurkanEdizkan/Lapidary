_and_moves_design_migrate_storage_job", "target": "specs_2026_09_06_folder_tree_and_moves_design_file_storage_path", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-09-06-folder-tree-and-moves-design.md", "source_location": null, "weight": 1.0}, {"source": "specs_2026_09_06_folder_tree_and_moves_design_migrate_storage_job", "target": "specs_2026_09_03_phase_1_slice_2_jobs_design_job_table", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-09-06-folder-tree-and-moves-design.md", "source_location": null, "weight": 1.0}, {"source": "specs_2026_09_06_folder_tree_and_moves_design_source_path_immutable", "target": "specs_2026_09_06_folder_tree_and_moves_design_part_folder_id", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-09-06-folder-tree-and-moves-design.md", "source_location": null, "weight": 1.0}, {"source": "specs_2026_09_06_folder_tree_and_moves_design_source_path_immutable", "target": "specs_2026_09_02_phase_1_slice_1_ingest_design_library_holds", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-09-06-folder-tree-and-moves-design.md", "source_location": null, "weight": 1.0}, {"source": "specs_2026_09_06_folder_tree_and_moves_design_part_move_table", "target": "specs_2026_09_02_phase_1_slice_1_ingest_design_part_table", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-09-06-folder-tree-and-moves-design.md", "source_location": null, "weight": 1.0}, {"source": "specs_2026_09_06_folder_tree_and_moves_design_part_move_table", "target": "specs_2026_09_06_folder_tree_and_moves_design_folder_table", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "