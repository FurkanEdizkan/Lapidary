{"nodes": [{"id": "plans_2026_09_05_phase_1_slice_4_resume_doc", "label": "Phase 1 Slice 4 Resume", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-05-phase-1-slice-4-RESUME.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Paused after task 7 at the owner's request. Instructs the successor to read the test count from cargo rather than trust a number written in any document, because the previous slice's plan asserted a baseline that moved four times."}, {"id": "plans_2026_09_05_phase_1_slice_4_resume_upsert_derivative_guards", "label": "upsert_derivative Guards", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-05-phase-1-slice-4-RESUME.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Refuse a hash-addressed thumbnail \u2014 the grid reads only thumb_bytes, so such a row shows 'no preview yet' for a part that has one, and revisions_missing excludes that revision so the sweep never heals it. Refuse an empty Inline \u2014 it reaches the grid as a broken img. Both guards go inside upsert_derivative, before the transaction, not at its call sites, so a refusal orphans no blob row."}], "edges": [{"source": "plans_2026_09_05_phase_1_slice_4_resume_doc", "target": "plans_2026_09_05_phase_1_slice_4_derivatives_doc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-09-05-phase-1-slice-4-RESUME.md", "source_location": null, "weight": 1.0}, {"source": "plans_2026_09_05_phase_1_slice_4_resume_upsert_derivative_guards", "target": "plans_2026_09_05_phase_1_slice_4_derivatives_derive_on_demand", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-09-05-phase-1-slice-4-RESUME.md", "source_location": null, "weight": 1.0}, {"source": "plans_2026_09_05_pha