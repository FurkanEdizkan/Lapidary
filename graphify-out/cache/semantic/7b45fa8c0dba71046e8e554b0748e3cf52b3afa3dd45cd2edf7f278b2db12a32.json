-phase-0a-foundation.md", "source_location": null, "weight": 1.0}, {"source": "plans_2026_09_01_phase_0a_foundation_task_ts_rs_pipeline", "target": "docs_architecture_why_not_grpc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-09-01-phase-0a-foundation.md", "source_location": null, "weight": 1.0}, {"source": "plans_2026_09_01_phase_0a_foundation_task_container_images", "target": "deploy_compose_stack", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-09-01-phase-0a-foundation.md", "source_location": null, "weight": 1.0}, {"source": "plans_2026_09_01_phase_0a_foundation_task_ci_supply_chain", "target": "workflows_ci_deny_job", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-09-01-phase-0a-foundation.md", "source_location": null, "weight": 1.0}, {"source": "plans_2026_09_01_phase_0a_foundation_task_ci_supply_chain", "target": "docs_architecture_agpl_only_licensing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-09-01-phase-0a-foundation.md", "source_location": null, "weight": 1.0}, {"source": "plans_2026_09_01_phase_0a_foundation_task_ci_supply_chain", "target": "claude_no_sql_outside_lapidary_db", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-09-01-phase-0a-foundation.md", "source_location": null, "weight": 1.0}, {"source": "plans_2026_09_01_phase_0a_foundation_task_exit_verification", "target": "docs_roadmap_phase_0", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-09-01-phase-0a-foundation.md", "source_location": null, "weight": 1.0}], "hyperedges": []}