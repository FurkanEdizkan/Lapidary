e_7_storage_lifecycle_design_revisionless_part_hole", "target": "specs_2026_09_06_phase_1_slice_6a_corpus_design_migration_0007", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-09-06-phase-1-slice-7-storage-lifecycle-design.md", "source_location": null, "weight": 1.0}, {"source": "specs_2026_09_01_phase_0a_foundation_design_lapidary_api", "target": "specs_2026_09_06_phase_1_slice_7_storage_lifecycle_design_soft_delete_route", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-09-06-phase-1-slice-7-storage-lifecycle-design.md", "source_location": null, "weight": 1.0}, {"source": "specs_2026_09_06_phase_1_slice_7_storage_lifecycle_design_reaper_sweep", "target": "specs_2026_09_03_phase_1_slice_2_jobs_design_job_table", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/superpowers/specs/2026-09-06-phase-1-slice-7-storage-lifecycle-design.md", "source_location": null, "weight": 1.0}, {"source": "specs_2026_09_06_phase_1_slice_7_storage_lifecycle_design_quarantine_timestamp", "target": "specs_2026_09_06_phase_1_slice_7_storage_lifecycle_design_soft_delete_route", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/superpowers/specs/2026-09-06-phase-1-slice-7-storage-lifecycle-design.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "three_step_deletion_lifecycle", "label": "The Three-Step Deletion Lifecycle", "nodes": ["specs_2026_09_06_phase_1_slice_7_storage_lifecycle_design_soft_delete_route", "specs_2026_09_06_phase_1_slice_7_storage_lifecycle_design_purge_recomputes", "specs_2026_09_06_phase_1_slice_7_storage_lifecycle_design_quarantine_timestamp", "specs_2026_09_06_phase_1_slice_7_storage_lifecycle_design_reaper_sweep", "specs_2026_09_07_purge_removes_the_model_directory_design_quarantined_file_t