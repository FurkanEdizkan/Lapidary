ce_location": null, "weight": 1.0}], "hyperedges": [{"id": "xtask_invariant_enforcement", "label": "xtask as the Place Invariants Fail Loudly", "nodes": ["plans_2026_09_01_phase_0a_verification_check_layers", "plans_2026_09_02_followup_15_deploy_check_check_deploy", "plans_2026_09_02_phase_0a_followups_round_2_forbidden_pairs", "plans_2026_09_02_phase_0a_followups_execution_enterprise_layer", "plans_2026_09_05_phase_1_slice_5_browser_open_path_boundary", "plans_2026_09_04_phase_1_slice_3_handoff_exempt_list_line_pinning"], "relation": "form", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/superpowers/plans/2026-09-02-followup-15-deploy-check.md"}]}