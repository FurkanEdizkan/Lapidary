{"nodes": [{"id": "plans_2026_09_06_folder_tree_and_moves_doc", "label": "Storage Layout, Folder Tree and Moves", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-06-folder-tree-and-moves.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Turns the blob store into a browsable storage folder holding one directory per model \u2014 its source file, its metadata.json and its images \u2014 with PostgreSQL indexing the paths, a category tree the user can reorganise, and an audit log of where each model has been."}, {"id": "plans_2026_09_06_folder_tree_and_moves_path_addressed_sources", "label": "Path-Addressed Source Storage", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-06-folder-tree-and-moves.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Source files move from blobs/ab/cd/<hash> to libraries/<lib>/<category>/<model>/<file> so the store is browsable outside the app. Derivatives stay content-addressed under cache/, which keeps /api/blob/{hash}'s immutable caching and makes 'eviction is not data loss' self-evident. part.source_path stays the immutable ingest identity key; folder_id carries mutable location and file.storage_path carries the bytes' real path."}, {"id": "plans_2026_09_06_folder_tree_and_moves_model_manifest", "label": "ModelManifest", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-06-folder-tree-and-moves.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The metadata.json shape and its schema version \u2014 what makes the store self-describing, so a model directory read without the database still says what it is."}, {"id": "plans_2026_09_06_folder_tree_and_moves_pg_folders", "label": "PgFolders", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-06-folder-tree-and-moves.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Get-or-create, tree, cycle check, subtree delete and moves. Fixtures use real category paths like Terrain/Rocks/Cliffs, never 'Folder 1'."}, {"id": "plans_2026_09_06_folder_tree_and_moves_part_move", "label": "part_move", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-06-folder-tree-and-moves.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An audit log of where each model has been, so a move is recoverable history rather than a silent overwrite of a location field."}, {"id": "plans_2026_09_06_folder_tree_and_moves_migrate_storage", "label": "JobPayload::MigrateStorage", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-06-folder-tree-and-moves.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Existing stores convert through a resumable job, not through the SQL migration. Moving every source file inside a migration would make a deploy an unbounded, uninterruptible filesystem operation with no progress and no way to resume."}, {"id": "plans_2026_09_06_folder_tree_and_moves_slugify", "label": "slugify", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-06-folder-tree-and-moves.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With disambiguate and reject_escaping_path, filesystem-safe names in lapidary-core so the ingest handler's local path guard is deleted rather than duplicated \u2014 one guard all callers route through."}, {"id": "plans_2026_09_06_folder_tree_and_moves_source_relocator", "label": "SourceRelocator", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-06-folder-tree-and-moves.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A third named type with exactly one allowed module in lapidary-api, following the SourceReader precedent: the boundary is a per-file allowance enforced by check-deploy rather than trust."}, {"id": "plans_2026_09_06_folder_tree_and_moves_dual_layout_reads", "label": "Dual-Layout Reads", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-09-06-folder-tree-and-moves.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reads tolerate both layouts \u2014 download reads from storage_path and falls back to the CAS path \u2014 so the resumable migration can be half-finished without any part becoming unreadable."}], "edges": [{"source": "plans_2026_09_06_folder_tree_and_moves_doc", "target": "plans_2026_09_06_folder_tree_and_moves_path_addressed_sources", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-09-06-folder-tree-and-moves.md", "source_location": null, "weight": 1.0}, {"source": "plans_2026_09_06_folder_tree_and_moves_doc", "target": "plans_2026_09_06_folder_tree_and_moves_pg_folders", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-09-06-folder-tree-and-moves.md", "source_location": null, "weight": 1.0}, {"source": "plans_2026_09_06_folder_tree_and_moves_doc", "target": "plans_2026_09_06_folder_tree_and_moves_slugify", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-09-06-folder-tree-and-moves.md", "source_location": null, "weight": 1.0}, {"source": "plans_2026_09_06_folder_tree_and_moves_slugify", "target": "plans_2026_09_06_folder_tree_and_moves_path_addressed_sources", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowe