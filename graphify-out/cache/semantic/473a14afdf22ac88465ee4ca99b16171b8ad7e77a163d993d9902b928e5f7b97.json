ht": 1.0}, {"source": "specs_2026_09_07_purge_removes_the_model_directory_design_phantom_blob_bytes", "target": "specs_2026_09_06_folder_tree_and_moves_design_migrate_storage_job", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-09-07-purge-removes-the-model-directory-design.md", "source_location": null, "weight": 1.0}, {"source": "specs_2026_09_07_purge_removes_the_model_directory_design_purge_model_dir", "target": "specs_2026_09_06_folder_tree_and_moves_design_source_dedup_lost", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-09-07-purge-removes-the-model-directory-design.md", "source_location": null, "weight": 1.0}], "hyperedges": []}