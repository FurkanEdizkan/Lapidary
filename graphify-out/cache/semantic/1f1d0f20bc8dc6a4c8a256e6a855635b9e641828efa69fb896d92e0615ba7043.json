{"nodes": [{"id": "specs_2026_09_01_phase_0a_foundation_design_phase_0a", "label": "Phase 0a \u2014 Greenfield Foundation", "file_type": "document", "source_file": "docs/superpowers/specs/2026-09-01-phase-0a-foundation-design.md", "source_location": null, "source_url": null, "captured_at": null, "contributor": null, "author": null, "rationale": "A fresh start rather than a staged migration from the Node prototype: the prototype survives on main and in history as a reference implementation, so nothing is lost by deleting it, and there is no half-migrated state to maintain."}, {"id": "specs_2026_09_01_phase_0a_foundation_design_crate_layering", "label": "L0-L3 Crate Layering Rule", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-01-phase-0a-foundation-design.md", "source_location": null, "source_url": null, "captured_at": null, "contributor": null, "author": null, "rationale": "Layering is enforced by an xtask over cargo metadata rather than cargo-deny, because deny's [bans] targets external crates and cannot express intra-workspace layering; an xtask is unit-testable against a synthetic graph and behaves identically locally and in CI. Superseded in part on 2026-09-02: lapidary-enterprise moved to its own Enterprise tier above L3."}, {"id": "specs_2026_09_01_phase_0a_foundation_design_xtask_check_layers", "label": "cargo xtask check-layers", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-01-phase-0a-foundation-design.md", "source_location": null, "source_url": null, "captured_at": null, "contributor": null, "author": null, "rationale": "Its unit tests assert the rule catches an injected violation, not merely that today's graph passes."}, {"id": "specs_2026_09_01_phase_0a_foundation_design_lapidary_core", "label": "lapidary-core (L0)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-01-phase-0a-foundation-design.md", "source_location": null, "source_url": null, "captured_at": null, "contributor": null, "author": null, "rationale": "Carries genuine domain surface from day one so the ts-rs pipeline is real and the layering check has actual edges to police."}, {"id": "specs_2026_09_01_phase_0a_foundation_design_lapidary_db", "label": "lapidary-db (L1)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-01-phase-0a-foundation-design.md", "source_location": null, "source_url": null, "captured_at": null, "contributor": null, "author": null, "rationale": "The only crate permitted to depend on sqlx; ALL SQL lives here, enforced by deny.toml."}, {"id": "specs_2026_09_01_phase_0a_foundation_design_lapidary_storage", "label": "lapidary-storage (L1)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-01-phase-0a-foundation-design.md", "source_location": null, "source_url": null, "captured_at": null, "contributor": null, "author": null}, {"id": "specs_2026_09_01_phase_0a_foundation_design_lapidary_cad", "label": "lapidary-cad (L2)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-01-phase-0a-foundation-design.md", "source_location": null, "source_url": null, "captured_at": null, "contributor": null, "author": null}, {"id": "specs_2026_09_01_phase_0a_foundation_design_lapidary_jobs", "label": "lapidary-jobs (L2)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-01-phase-0a-foundation-design.md", "source_location": null, "source_url": null, "captured_at": null, "contributor": null, "author": null}, {"id": "specs_2026_09_01_phase_0a_foundation_design_lapidary_index", "label": "lapidary-index (L2)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-01-phase-0a-foundation-design.md", "source_location": null, "source_url": null, "captured_at": null, "contributor": null, "author": null}, {"id": "specs_2026_09_01_phase_0a_foundation_design_lapidary_api", "label": "lapidary-api (L3)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-01-phase-0a-foundation-design.md", "source_location": null, "source_url": null, "captured_at": null, "contributor": null, "author": null, "rationale": "A library that builds and returns a Router. Never a binary, never forked per distribution."}, {"id": "specs_2026_09_01_phase_0a_foundation_design_lapidary_server_bin", "label": "bin/lapidary-server", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-01-phase-0a-foundation-design.md", "source_location": null, "source_url": null, "captured_at": null, "contributor": null, "author": null}, {"id": "specs_2026_09_01_phase_0a_foundation_design_kernel_trait", "label": "Kernel trait", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-01-phase-0a-foundation-design.md", "source_location": null, "source_url": null, "captured_at": null, "contributor": null, "author": null, "rationale": "The trait's shape is what is stable; KernelOutput's fields explicitly are not."}, {"id": "specs_2026_09_01_phase_0a_foundation_design_mock_kernel", "label": "MockKernel", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-01-phase-0a-foundation-design.md", "source_location": null, "source_url": null, "captured_at": null, "contributor": null, "author": null, "rationale": "The boring option for 0a: subprocess spawn, timeout and crash handling land in 0b with the real sidecar rather than being written twice."}, {"id": "specs_2026_09_01_phase_0a_foundation_design_approximate_wrapper", "label": "Approximate<T>", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-01-phase-0a-foundation-design.md", "source_location": null, "source_url": null, "captured_at": null, "contributor": null, "author": null, "rationale": "Makes 'mesh-derived, label it approximate' unavoidable at the type level rather than a UI convention."}, {"id": "specs_2026_09_01_phase_0a_foundation_design_library_mode", "label": "LibraryMode (Hobby | Controlled)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-01-phase-0a-foundation-design.md", "source_location": null, "source_url": null, "captured_at": null, "contributor": null, "author": null, "rationale": "Governance is opt-in per library, so the mode is a domain type from the start."}, {"id": "specs_2026_09_01_phase_0a_foundation_design_part_summary", "label": "PartSummary", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-01-phase-0a-foundation-design.md", "source_location": null, "source_url": null, "captured_at": null, "contributor": null, "author": null, "rationale": "One `approximate: bool` is correct for a grid card, which wants one badge; the detail view legitimately differs in granularity."}, {"id": "specs_2026_09_01_phase_0a_foundation_design_ts_rs_bindings", "label": "ts-rs Binding Export Pipeline", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-01-phase-0a-foundation-design.md", "source_location": null, "source_url": null, "captured_at": null, "contributor": null, "author": null, "rationale": "web/src/bindings/ is committed, not gitignored, so CI can compare regenerated output against it and catch staleness; routeTree.gen.ts is committed for the same reason, because tsc runs before Vite on a clean clone."}, {"id": "specs_2026_09_01_phase_0a_foundation_design_compose_topology", "label": "web / api / worker / db Compose Topology", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-01-phase-0a-foundation-design.md", "source_location": null, "source_url": null, "captured_at": null, "contributor": null, "author": null, "rationale": "Four services, no Redis and no broker; cache is Postgres. Compose Spec syntax working under both podman compose and docker compose, with --env-file passed explicitly because the two runtimes disagree about auto-loading."}, {"id": "specs_2026_09_01_phase_0a_foundation_design_agpl_licence", "label": "AGPL-3.0-only Single Workspace Licence", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-01-phase-0a-foundation-design.md", "source_location": null, "source_url": null, "captured_at": null, "contributor": null, "author": null, "rationale": "lapidary-enterprise stays AGPL; the Ed25519 licence file is a contractual and support boundary, not technical DRM. Keeps DCO, avoids a CLA."}, {"id": "specs_2026_09_01_phase_0a_foundation_design_prototype_deletion", "label": "Deletion of the Node Prototype", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-01-phase-0a-foundation-design.md", "source_location": null, "source_url": null, "captured_at": null, "contributor": null, "author": null, "rationale": "Accepted cost: no runnable application on the branch until Phase 1, so there is no live reference to diff behaviour against. Domain knowledge in server/src/services/ is recorded crate-by-crate before deletion."}, {"id": "specs_2026_09_01_phase_0a_foundation_design_tanstack_spa", "label": "Vite + React + TanStack SPA", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-01-phase-0a-foundation-design.md", "source_location": null, "source_url": null, "captured_at": null, "contributor": null, "author": null, "rationale": "Next.js would put a Node runtime in the production container; the later Tauri app bundles only our own binaries and cannot ship a Next server. SSR buys nothing for an authenticated tool that opens on a virtualized grid."}, {"id": "specs_2026_09_01_phase_0a_foundation_design_sqlx_embedded_migrator", "label": "sqlx::migrate! Embedded Migrator", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-01-phase-0a-foundation-design.md", "source_location": null, "source_url": null, "captured_at": null, "contributor": null, "author": null, "rationale": "Migrations are embedded at compile time and applied at startup, so an image carries its own schema and an air-gapped operator needs no migration tooling on the host."}, {"id": "specs_2026_09_01_phase_0a_foundation_design_cargo_deny", "label": "cargo-deny Source and Licence Gate", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-01-phase-0a-foundation-design.md", "source_location": null, "source_url": null, "captured_at": null, "contributor": null, "author": null}, {"id": "specs_2026_09_01_phase_0a_foundation_design_pinning_rule", "label": "Pin Everything", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-09-01-phase-0a-foundation-design.md", "source_location": null, "source_url": null, "captured_at": null, "contributor": null, "author": null, "rationale": "Exact versions with no carets, container digests, Cargo.lock committed, GitHub Actions pinned to commit SHAs \u2014 so an air-gapped build reproduces."}], "edges": [{"source": "specs_2026_09_01_phase_0a_foundation_design_xtask_check_layers", "target": "specs_2026_09_01_phase_0a_foundation_design_crate_layering", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-09-01-phase-0a-foundation-design.md", "source_location": null, "weight": 1.0}, {"source": "specs_2026_09_01_phase_0a_foundation_design_phase_0a", "target": "specs_2026_09_01_phase_0a_foundation_design_crate_layering", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-09-01-phase-0a-foundation-design.md", "source_location": null, "weight": 1.0}, {"source": "specs_2026_09_01_phase_0a_foundation_design_mock_kernel", "target": "specs_2026_09_01_phase_0a_foundation_design_kernel_trait", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-09-01-phase-0a-foundation-design.md", "source_location": null, "weight": 1.0}, {"source": "specs_2026_09_01_phase_0a_foundation_design_lapidary_cad", "target": "specs_2026_09_01_phase_0a_foundation_design_kernel_trait", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/spe