# Copy to deploy/.env and edit. Never commit deploy/.env.

POSTGRES_USER=lapidary
# You must set a value here — compose refuses to start until you do.
POSTGRES_PASSWORD=
POSTGRES_DB=lapidary

# Used by lapidary-server inside the containers. Compose builds it from the values
# above; set it directly only when running the binary outside a container.
# DATABASE_URL=postgres://lapidary:<POSTGRES_PASSWORD>@localhost:5432/lapidary

LAPIDARY_LOG=info

# The directory the worker scans, mounted read-only at /ingest. Relative paths are
# resolved against deploy/, not against the repository root — that is compose's rule for
# volume sources, not ours. Absolute paths are the safer habit for anything outside the
# repository.
#
# Left unset, deploy/compose.yaml falls back to ../example/parts: six real parts
# (a flange, a spur gear, a vee block, a mounting plate, a hex spacer, an idler pulley)
# committed to this repository so a first run shows a populated grid rather than an empty
# one. Point it at your own folder once you have one.
#
# The scan descends into subdirectories, to a depth of 16, skipping dot-entries and not
# following symlinked directories. A file's path relative to this directory is its
# identity in the library, so two files called bracket.stl in two folders are two parts.
# LAPIDARY_INGEST_DIR=/srv/parts

# Where the api assembles a partial upload before verifying it and moving it into the
# blob store. deploy/compose.yaml sets it to /var/lib/lapidary-uploads and mounts a named
# volume there; set it only when running the binary outside a container. Never point it
# inside LAPIDARY_BLOB_ROOT — everything under that root is content-addressed and
# complete, and a half-transferred file is neither.
# LAPIDARY_UPLOAD_DIR=/var/lib/lapidary-uploads

# The bundled example parts, ingested once on the first start of a library nothing has
# ever run in, so a first run is never an empty grid. deploy/Containerfile copies them to
# /usr/share/lapidary/example-parts and deploy/compose.yaml points this there.
#
# Deliberately not LAPIDARY_INGEST_DIR, even though that defaults to the same six files:
# that one is yours, and pointing it at a large library must never mean the worker scans
# it because you restarted. Unset this to start with an empty grid.
# LAPIDARY_EXAMPLE_DIR=/usr/share/lapidary/example-parts

# --- Job worker ---------------------------------------------------------------
# All optional, and all worker-only: the api service runs no worker. Leave any of them
# unset and bin/lapidary-server uses lapidary_jobs::WorkerConfig's default, given after
# each name. deploy/compose.yaml passes them through empty when unset, which the binary
# reads as "unset" rather than as a bad value.

# How many files the worker ingests at once. Default 4.
# LAPIDARY_WORKER_CONCURRENCY=4

# How long a claimed job stays leased to this worker before another worker may reclaim
# it. A job whose lease expires is treated as a crashed worker's and handed out again,
# so this must comfortably exceed the slowest single file's ingest. Default 60.
# LAPIDARY_JOB_LEASE_SECS=60

# How often the worker looks for work when nothing has notified it. This is the floor
# that makes delivery correct rather than an optimization — NOTIFY only makes it
# faster — so lowering it costs queries and raising it costs latency, but neither can
# lose a job. Default 5.
# LAPIDARY_JOB_POLL_SECS=5

# What this worker calls itself in `job.leased_by`. Defaults to <hostname>-<pid>, which
# is what you want unless you run several workers and need to tell them apart when
# reading the job table.
# LAPIDARY_WORKER_ID=
