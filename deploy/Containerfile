# syntax=docker/dockerfile:1
# Rust workspace -> lapidary-server. No CAD kernel: Lapidary is a visual index of meshes, and STEP
# and IGES are refused by name (`lapidary_core::cad_refusal`). The `occt` and `occt-test` stages
# that built OCCT V8.0.1 from source were 766 s of an 849 s cold build and a 2.92 GB test image;
# they were removed with the kernel.

# The browser app. Was its own Caddy image until S1; the server serves `dist/` itself now.
FROM docker.io/library/node:24-trixie@sha256:499ac30d42645e5c2227c0f8ff2439499da08b8893326a991f192dfe8e6b1d98 AS web
WORKDIR /src
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web ./
RUN npm run build

FROM docker.io/library/rust:1.95-trixie@sha256:443dd9a3260cf23c22fc05051dd5661dd7b4028d3d25dbaffab6563b63c3539c AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates
COPY bin ./bin
COPY xtask ./xtask
# The base image tag above is pinned by digest, and rust-toolchain.toml (copied above)
# pins the same version by channel string — they agree today only because both pins point
# at the same release. Once rust-toolchain.toml is on disk, invoking rustc/cargo from
# inside /src makes rustup honor it as a directory override and silently fetch a matching
# toolchain over the network if the image's installed rustc has drifted — exactly the
# hermetic-build-turns-network-dependent failure we're guarding against, and it would mask
# a mismatch instead of surfacing one. So this checks the image's actual installed rustc
# from outside /src, where no override file is in scope. If this fires: bump
# rust-toolchain.toml and the image digest together, to the same release.
#
# Both captured values are checked for emptiness before comparing: a shell pipeline's exit
# status is only its last stage's, so a broken grep/sed (e.g. the channel line's format
# changes) or a broken awk (e.g. rustc's output shape changes) degrades silently to an
# empty string rather than failing the RUN — and two empty strings compare equal, which
# would make this check pass having verified nothing. That failure mode gets its own
# message, distinct from a genuine mismatch, because the fix is different: update this
# check's parsing, not the pins.
RUN set -eu; \
    expected="$(grep -m1 '^channel' rust-toolchain.toml | sed -E 's/.*"([^"]+)".*/\1/')"; \
    actual="$(cd / && rustc --version | awk '{print $2}')"; \
    if [ -z "$expected" ] || [ -z "$actual" ]; then \
        echo "Could not parse a toolchain version to compare (rust-toolchain.toml channel='$expected', rustc --version='$actual') — this check's parsing is stale, not the pins; update the grep/sed or awk above to match the current file/output shape." >&2; \
        exit 1; \
    fi; \
    if [ "$actual" != "$expected" ]; then \
        echo "rustc $actual in the base image does not match the rust-toolchain.toml pin $expected — bump rust-toolchain.toml and the image digest together." >&2; \
        exit 1; \
    fi
RUN cargo build --release --locked -p lapidary-server

FROM docker.io/library/debian:trixie-slim@sha256:abc9cb88a5587630d7f915f47b23b0668fe250fbfc6457aa4d52b534c1bbf73f AS runtime
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*
RUN useradd --system --uid 10001 --create-home lapidary
# Every directory a named volume mounts over, created in the image and owned by the runtime
# user: the blob store, the upload staging, and the peer role's identity key and pull
# staging (deploy/compose.sharing.yaml). Both Docker and Podman seed a freshly created named
# volume from whatever the image has at the mount point, ownership included; with no
# directory here the volume comes up owned by root and this container, which does not run
# as root, cannot write to it. Goal 8 found the peer's two missing by running the images:
# the peer could not write its key and exited. `cargo xtask check-deploy` now holds every
# named volume a lapidary-server service mounts to a line here. The key's directory is 0700:
# it holds a private key and nothing else.
RUN install -d -o lapidary -g lapidary -m 0755 /var/lib/lapidary \
    && install -d -o lapidary -g lapidary -m 0755 /var/lib/lapidary-uploads \
    && install -d -o lapidary -g lapidary -m 0700 /var/lib/lapidary-peer \
    && install -d -o lapidary -g lapidary -m 0755 /var/lib/lapidary-peer-staging
# The bundled example parts, so a first run is never an empty grid. 216 kB of real
# geometry with a committed generator beside it (example/parts/generate.py), and a path
# the image owns rather than the operator's /ingest mount — see `lapidary_ingest::seed`
# for why those must not be the same directory. `--parents` is avoided: only the meshes
# are wanted, not the generator.
COPY example/parts/*.stl /usr/share/lapidary/example-parts/
COPY --from=web /src/dist /usr/share/lapidary/web
COPY --from=build /src/target/release/lapidary-server /usr/local/bin/lapidary-server
USER lapidary
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/lapidary-server"]
